    document.getElementById('view-admin').style.display = 'none';
    document.getElementById(viewId).style.display = 'block';
    if(document.getElementById('sidebar').classList.contains('active')) toggleMenu();
}

function toggleMenu() {
    document.getElementById('sidebar').classList.toggle('active');
    document.getElementById('sidebarOverlay').classList.toggle('active');
}

// LOGOUT
function logout() {
    currentUser = "";
    document.getElementById('loginUser').value = "";
    document.getElementById('loginPass').value = "";
    document.getElementById('loginOverlay').style.display = 'flex';
    if(document.getElementById('sidebar').classList.contains('active')) toggleMenu();
}

function notification(text){
    const pop = document.createElement("div");
    pop.className = "popup-notif";
    pop.innerText = text;
    document.body.appendChild(pop);
    setTimeout(() => pop.remove(), 2500);
}

function enviarPedido() {
    const c = document.getElementById('order-country').value.trim();
    const p = document.getElementById('order-product').value.trim();
    if(!c || !p) return notification("INGRESA LOS DATOS REQUERIDOS");
    
    const textMsg = `Hola 1NCOG SOCIETY.\nQuiero realizar un pedido:\n\n🌍 País de origen: ${c}\n📦 Producto: ${p}`;
    window.open(`https://wa.me/56920012710?text=${encodeURIComponent(textMsg)}`, '_blank');
}

// FONDO ANIMADO MATRIX
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
canvas.width = window.innerWidth; canvas.height = window.innerHeight;
const cols = Array(Math.floor(canvas.width / 20)).fill(1);
function draw() {
    ctx.fillStyle = "rgba(6,6,12,0.06)"; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "#a855f7"; ctx.font = "15px monospace";
    cols.forEach((y, i) => {
        ctx.fillText(Math.floor(Math.random() * 2), i * 20, y * 20);
        if (y * 20 > canvas.height && Math.random() > 0.975) cols[i] = 0;
        cols[i]++;
    });
}
setInterval(draw, 50);

window.addEventListener('resize', () => {
    canvas.width = window.innerWidth; canvas.height = window.innerHeight;
});
</script>
