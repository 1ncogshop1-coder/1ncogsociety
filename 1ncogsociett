  <script>
    let currentProduct = "";
    let currentPrice = 0;
    const whatsappNumber = "56920012710";

    function openModal(name, price) {
      currentProduct = name;
      currentPrice = price;
      document.getElementById('modalProductName').innerText = "Comprar " + name;
      document.getElementById('modalProductPrice').innerText = "$" + price + " USD";
      document.getElementById('checkoutModal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('checkoutModal').classList.add('hidden');
      document.getElementById('receiptInput').value = "";
      document.getElementById('fileLabel').innerText = "Sube tu comprobante aquí";
    }

    function updateFileName(input) {
      if (input.files && input.files[0]) {
        document.getElementById('fileLabel').innerText = input.files[0].name;
      }
    }

    function handleSendWhatsApp(event) {
      event.preventDefault();
      const message = `Hola! Vengo de la web NOVA SOCIETY.%0A%0A*Producto:* ${currentProduct}%0A*Precio:* $${currentPrice} USD%0A%0AAdjunto mi comprobante de pago.`;
      window.open(`https://wa.me/${whatsappNumber}?text=${message}`, '_blank');
      closeModal();
    }
  </script>

