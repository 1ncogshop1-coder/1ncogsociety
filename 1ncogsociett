function renderFrontData() {
    // 1. Render en vista cliente
    const clientList = document.getElementById('client-prices-list');
    clientList.innerHTML = "";
    const keysProd = Object.keys(productos);
    if(keysProd.length === 0) {
        clientList.innerHTML = "<p style='text-align:center; color:var(--text-muted); font-size:13px;'>No hay productos activos.</p>";
    } else {
        keysProd.forEach(key => {
            clientList.innerHTML += `<div class="price-item"><span>${productos[key].name}</span><span>${productos[key].price}</span></div>`;
        });
    }

    // 2. Render en panel administrativo de productos
    const adminListProd = document.getElementById('admin-prices-list');
    adminListProd.innerHTML = "<p style='font-size:12px; margin-bottom:10px; color:var(--text-muted);'>PRODUCTOS EN PLATAFORMA:</p>";
    keysProd.forEach(key => {
        adminListProd.innerHTML += `
            <div class="admin-list-item">
                <div><strong>${productos[key].name}</strong> - ${productos[key].price}</div>
                <button class="btn-danger" onclick="eliminarProducto('${key}')">ELIMINAR</button>
            </div>`;
    });

    // 3. Render en panel de usuarios
    const adminListUser = document.getElementById('admin-users-list');
    adminListUser.innerHTML = "<p style='font-size:12px; margin-bottom:10px; color:var(--text-muted);'>SOCIOS LOGUEADOS:</p>";
    Object.keys(usuarios).forEach(key => {
        const deleteBtn = usuarios[key].user === "ADMIN" ? "" : `<button class="btn-danger" onclick="eliminarUsuario('${key}')">BORRAR</button>`;
