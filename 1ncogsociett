            <div class="admin-list-item">
                <div>👤 <strong>${usuarios[key].user}</strong> (Pass: ${usuarios[key].pass})</div>
                ${deleteBtn}
            </div>`;
    });
}

// VALIDACIÓN DE LOGINS
function validarLogin() {
    const userIn = document.getElementById('loginUser').value.trim();
    const passIn = document.getElementById('loginPass').value.trim();

    let cuentaEncontrada = null;
    Object.keys(usuarios).forEach(key => {
        if(usuarios[key].user.toUpperCase() === userIn.toUpperCase() && usuarios[key].pass === passIn) {
            cuentaEncontrada = usuarios[key];
        }
    });

    if (cuentaEncontrada) {
        currentUser = cuentaEncontrada.user.toUpperCase();
        document.getElementById('loginOverlay').style.display = 'none';
        
        if (currentUser === "ADMIN") {
            document.getElementById('nav-admin').style.display = 'block';
            switchView('view-admin');
        } else {
            document.getElementById('nav-admin').style.display = 'none';
            switchView('view-pedidos');
        }
        notification("SISTEMA AUTORIZADO: " + currentUser);
    } else {
        notification("❌ CREDENCIALES INCORRECTAS");
    }
}

// CONTROL DE INVENTARIO
function agregarProducto() {
    const name = document.getElementById('admin-prod-name').value.trim().toUpperCase();
    const price = document.getElementById('admin-prod-price').value.trim();

    if(!name || !price) return notification("COMPLETA AMBOS CAMPOS");

    const id = "prod_" + Date.now();
    productos[id] = { name: name, price: price };
    
    localStorage.setItem('incog_productos', JSON.stringify(productos));
    renderFrontData();

    document.getElementById('admin-prod-name').value = "";
    document.getElementById('admin-prod-price').value = "";
    notification("PRODUCTO EN LÍNEA");
}

function eliminarProducto(id) {
    delete productos[id];
    localStorage.setItem('incog_productos', JSON.stringify(productos));
    renderFrontData();
}

// GESTIÓN DE ACCESOS
function agregarUsuario() {
    const user = document.getElementById('admin-user-name').value.trim();
    const pass = document.getElementById('admin-user-pass').value.trim();

    if(!user || !pass) return notification("RELLENA TODOS LOS CAMPOS");

    let existe = false;
    Object.keys(usuarios).forEach(key => {
        if(usuarios[key].user.toUpperCase() === user.toUpperCase()) existe = true;
    });

    if(existe) return notification("ESTE SOCIO YA EXISTE");

    const id = "user_" + Date.now();
    usuarios[id] = { user: user, pass: pass };
    
    localStorage.setItem('incog_usuarios', JSON.stringify(usuarios));
    renderFrontData();

    document.getElementById('admin-user-name').value = "";
    document.getElementById('admin-user-pass').value = "";
    notification("SOCIO AUTORIZADO");
}

function eliminarUsuario(id) {
    delete usuarios[id];
    localStorage.setItem('incog_usuarios', JSON.stringify(usuarios));
    renderFrontData();
}

